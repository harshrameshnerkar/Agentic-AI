# OpsSentinel Enterprise - Production Environment Variables Template
ENVIRONMENT=production
DEBUG=false

# API and Dashboard Networking
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# LLM Configuration
LLM_PROVIDER=google-genai
MODEL_NAME=gemini-2.5-flash
TEMPERATURE=0.1
MAX_TOKENS=1024

# Concurrency & Blast Radius
MAX_CONCURRENT_TOOLS=5
TOOL_TIMEOUT_SECONDS=10.0
APPROVAL_TOKEN_EXPIRY_SECONDS=1800

# CI Evaluation SLA
MIN_CI_PASS_RATE=0.90
MAX_CI_CRITICAL_REGRESSIONS=0
MAX_CI_P95_LATENCY_MS=3000.0
